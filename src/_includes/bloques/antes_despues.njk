<!-- ============ ANTES Y DESPUÉS ============ -->
<section class="section compare"{{ b | estiloSeccion | safe }}>
  <div class="container">
    {% if b.encabezado and b.encabezado.titulo %}
    {% set e = b.encabezado %}
{% include "partials/encabezado.njk" %}

    {% endif %}
    <div class="compare__stage reveal" data-delay="2">
      <div class="compare__rail" id="baRail" tabindex="0" aria-label="Transformaciones, deslice para ver más">
        {% for c in b.elementos %}
        <article class="ba-card">
          <div class="ba" style="--v:50%">
            <img class="ba__img ba__img--after" src="{{ c.despues }}" alt="{{ c.despues_alt }}"{% if loop.index > 3 %} loading="lazy"{% endif %}>
            <img class="ba__img ba__img--before" src="{{ c.antes }}" alt="{{ c.antes_alt }}"{% if loop.index > 3 %} loading="lazy"{% endif %}>
            <span class="ba__label ba__label--before">Antes</span>
            <span class="ba__label ba__label--after">Después</span>
            <button class="ba__handle" type="button" role="slider"
                    aria-label="Comparar {{ c.titulo }}: antes y después" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <p class="ba-card__title"><strong>{{ c.titulo }}</strong>{% if c.detalle %} · {{ c.detalle }}{% endif %}</p>
        </article>
        {% endfor %}
      </div>

      <div class="compare__controls">
        <div class="compare__dots" id="baDots" role="tablist" aria-label="Elegir transformación"></div>
        <div class="compare__nav">
          <button class="icon-btn icon-btn--outline" type="button" id="baPrev" aria-label="Ver transformaciones anteriores">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="icon-btn icon-btn--outline" type="button" id="baNext" aria-label="Ver más transformaciones">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
