<!-- ============ IMAGEN + TEXTO ============ -->
<section class="section"{{ b | estiloSeccion | safe }}>
  <div class="container split{% if b.imagen_derecha %} split--reverse{% endif %}">
    <div class="split__media">
      <figure class="split__img reveal reveal--clip">
        <img src="{{ b.imagen }}" alt="{{ b.imagen_alt }}" loading="lazy" sizes="(max-width: 980px) 92vw, 560px">
      </figure>
      {% if b.imagen_flotante %}
      <figure class="split__float" data-parallax="-0.08">
        <img src="{{ b.imagen_flotante }}" alt="{{ b.imagen_flotante_alt }}" loading="lazy" sizes="260px">
      </figure>
      {% endif %}
      {% if b.sello and b.sello.cifra %}
      <div class="split__badge reveal" data-delay="2">
        <strong>{{ b.sello.cifra }}</strong>
        <span>{{ b.sello.texto | inline | safe }}</span>
      </div>
      {% endif %}
    </div>

    <div class="split__text">
      {% if b.antetitulo %}
      <p class="eyebrow reveal"><span class="dot"></span> {{ b.antetitulo }}</p>
      {% endif %}
      <h2 class="h2 reveal" data-delay="1">{{ b.titulo | inline | safe }}</h2>
      {% if b.entradilla %}
      <p class="lead reveal" data-delay="2">{{ b.entradilla | inline | safe }}</p>
      {% endif %}
      {% for p in b.parrafos %}
      <p class="reveal" data-delay="2">{{ p | inline | safe }}</p>
      {% endfor %}
      {% if b.lista and b.lista.length %}
      <ul class="ticks reveal" data-delay="3">
        {% for li in b.lista %}
        <li>{{ li | inline | safe }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if b.enlace and b.enlace.texto %}
      <a class="{{ 'btn btn--solid btn--lg' if b.enlace.estilo == 'boton' else 'link-arrow' }} reveal" data-delay="3" href="{{ b.enlace.url }}">
        {{ b.enlace.texto }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {% endif %}
    </div>
  </div>
</section>
