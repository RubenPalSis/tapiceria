<!-- ============ LLAMADA A LA ACCIÓN ============ -->
<section class="cta-band"{{ b | estiloSeccion | safe }}>
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <h2 class="h2 reveal">{{ b.titulo | inline | safe }}</h2>
      <p class="reveal" data-delay="1">{{ b.texto | inline | safe }}</p>
      <div class="btn-row reveal" data-delay="2">
        {% if b.boton and b.boton.texto %}
        <a class="btn btn--light btn--lg" href="{{ b.boton.url }}">{{ b.boton.texto }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        {% endif %}
        {% if b.boton_whatsapp and b.boton_whatsapp.texto %}
        <a class="btn btn--wa btn--lg" href="{{ b.boton_whatsapp.mensaje | whatsapp(site.whatsapp) }}" target="_blank" rel="noopener">{% include "partials/ico-whatsapp.njk" %} {{ b.boton_whatsapp.texto }}</a>
        {% endif %}
      </div>
    </div>
    {% if b.pasos and b.pasos.length %}
    <ol class="steps">
      {% for p in b.pasos %}
      <li class="reveal" data-delay="{{ loop.index }}"><span class="steps__n">{{ loop.index | dosCifras }}</span><div><h3>{{ p.titulo }}</h3><p>{{ p.texto }}</p></div></li>
      {% endfor %}
    </ol>
    {% endif %}
  </div>
</section>
