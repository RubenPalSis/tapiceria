---
layout: base.njk
---
{% set nombreCat = categoria | nombreCategoria(categorias) %}
<article class="work" data-zoom-group>
  <header class="work-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/trabajos/">Trabajos</a><span aria-hidden="true">/</span>
        <span aria-current="page">{{ titulo }}</span>
      </nav>
      <div class="work-hero__meta reveal">
        <a class="chip chip--brand" href="/trabajos/">{{ nombreCat }}</a>
        {% if fecha %}<time datetime="{{ fecha }}">{{ fecha | fechaLarga }}</time>{% endif %}
        {% if lugar %}<span>{{ lugar }}</span>{% endif %}
      </div>
      <h1 class="h1 reveal" data-delay="1">{{ titulo }}</h1>
      <p class="lead reveal" data-delay="2">{{ resumen }}</p>
    </div>
  </header>

  <div class="container">
    {% if antes_despues and antes_despues.antes %}
    <div class="work__cover work__cover--ba">
      <div class="ba" style="--v:50%">
        <img class="ba__img ba__img--after vt-foto" src="{{ antes_despues.despues }}" alt="{{ titulo }}: después" fetchpriority="high" sizes="(max-width: 1300px) 96vw, 1240px">
        <img class="ba__img ba__img--before" src="{{ antes_despues.antes }}" alt="{{ titulo }}: antes" sizes="(max-width: 1300px) 96vw, 1240px">
        <span class="ba__label ba__label--before">Antes</span>
        <span class="ba__label ba__label--after">Después</span>
        <button class="ba__handle" type="button" role="slider" aria-label="Comparar antes y después" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 7 4 12l5 5M15 7l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    {% else %}
    <figure class="work__cover">
      <button class="tile__zoom" type="button" data-zoom data-caption="{{ titulo }}" aria-label="Ampliar foto">
        <img class="vt-foto" src="{{ portada }}" alt="{{ portada_alt or titulo }}" fetchpriority="high" sizes="(max-width: 1300px) 96vw, 1240px">
      </button>
    </figure>
    {% endif %}
  </div>

  <div class="container work__body">
    <div class="work__text reveal">
      {{ content | safe }}
    </div>
    <aside class="work__aside reveal" data-delay="1">
      <dl class="work__facts">
        <div><dt>Tipo de trabajo</dt><dd>{{ nombreCat }}</dd></div>
        {% if lugar %}<div><dt>Lugar</dt><dd>{{ lugar }}</dd></div>{% endif %}
        {% if fecha %}<div><dt>Fecha</dt><dd>{{ fecha | fechaLarga }}</dd></div>{% endif %}
      </dl>
      <p class="work__ask">¿Tiene un mueble parecido? Envíenos una foto y le decimos cómo quedaría.</p>
      <a class="btn btn--wa btn--lg btn--block" href="{{ ('Hola, he visto el trabajo «' + titulo + '» en vuestra web y quería pedir presupuesto') | whatsapp(site.whatsapp) }}" target="_blank" rel="noopener">{% include "partials/ico-whatsapp.njk" %} Pedir presupuesto</a>
      <a class="btn btn--line btn--lg btn--block" href="tel:{{ site.telefono }}">Llamar al {{ site.telefono_corto }}</a>
    </aside>
  </div>

  {% if fotos and fotos.length %}
  <section class="section section--tight">
    <div class="container">
      <h2 class="h3 reveal">Más fotos del trabajo</h2>
      <div class="gallery gallery--work">
        {% for f in fotos %}
        <figure class="tile reveal" data-delay="{{ (loop.index0 % 3) + 1 }}">
          <button class="tile__zoom" type="button" data-zoom data-caption="{{ f.alt }}" aria-label="Ampliar: {{ f.alt }}">
            <img src="{{ f.imagen }}" alt="{{ f.alt }}" loading="lazy" sizes="(max-width: 980px) 96vw, 620px">
          </button>
        </figure>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
</article>

{% set relacionados = collections.trabajos | relacionados(page.url, categoria, 3) %}
<section class="section works" style="background:var(--bg-2)">
  <div class="container">
    <header class="section-head section-head--row">
      <div>
        <p class="eyebrow reveal"><span class="dot"></span> Siga mirando</p>
        <h2 class="h2 reveal" data-delay="1">Más <em>trabajos</em></h2>
      </div>
      <a class="link-arrow reveal" href="/trabajos/">Ver todos
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </header>
    <div class="wgrid">
      {% for t in relacionados %}
{% include "partials/tarjeta_trabajo.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
