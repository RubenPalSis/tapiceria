        <div class="channels">
          <a class="channel channel--wa" href="{{ '' | whatsapp(site.whatsapp) }}" target="_blank" rel="noopener">
            <span class="channel__icon">{% include "partials/ico-whatsapp.njk" %}</span>
            <span class="channel__txt"><small>La opción más rápida</small><strong>WhatsApp</strong><span>{{ site.telefono_corto }}</span></span>
            <span class="channel__arrow" aria-hidden="true">→</span>
          </a>
          <a class="channel" href="tel:{{ site.telefono }}">
            <span class="channel__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6L16.5 13l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z" stroke-linejoin="round"/></svg></span>
            <span class="channel__txt"><small>Llámenos</small><strong>Teléfono</strong><span>{{ site.telefono_visible }}</span></span>
            <span class="channel__arrow" aria-hidden="true">→</span>
          </a>
          <a class="channel" href="mailto:{{ site.email }}">
            <span class="channel__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.8 6.8 7.3 5.2a1.5 1.5 0 0 0 1.8 0l7.3-5.2" stroke-linecap="round"/></svg></span>
            <span class="channel__txt"><small>Escríbanos</small><strong>Email</strong><span>{{ site.email }}</span></span>
            <span class="channel__arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="channels__hours"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round"/></svg> {{ site.horario }}</p>
