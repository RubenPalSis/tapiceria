        <form class="form-card" id="contactForm" novalidate>
          {% if formTitulo %}
          <div class="form-card__head">
            <h3>{{ formTitulo }}</h3>
            {% if formTexto %}<p>{{ formTexto }}</p>{% endif %}
          </div>
          {% endif %}

          <div class="c-form-grid">
            <div class="c-field c-field--full">
              <label for="nombre">Nombre y apellidos *</label>
              <input type="text" id="nombre" name="nombre" autocomplete="name" placeholder="Ej. Carmen González" required>
            </div>
            <div class="c-field">
              <label for="telefono">Teléfono *</label>
              <input type="tel" id="telefono" name="telefono" autocomplete="tel" placeholder="Ej. 654 00 00 00" required>
            </div>
            <div class="c-field">
              <label for="email">Email (opcional)</label>
              <input type="email" id="email" name="email" autocomplete="email" placeholder="carmen@ejemplo.com">
            </div>
            <div class="c-field c-field--full">
              <label for="servicio">Servicio o tipo de mueble</label>
              <div class="c-select-wrap">
                <select id="servicio" name="servicio">
                  {% for s in formServicios %}
                  <option>{{ s }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="c-field c-field--full">
              <label for="mensaje">¿Qué necesita tapizar o reparar? *</label>
              <textarea id="mensaje" name="mensaje" rows="4" placeholder="Describa el mueble, medidas aproximadas o el tipo de tela que busca…" required></textarea>
            </div>
          </div>

          <p class="form__error" id="formError" role="alert" hidden></p>

          <div class="c-form-actions">
            <button class="btn btn--wa btn--lg" type="submit" data-method="whatsapp">{% include "partials/ico-whatsapp.njk" %} Enviar por WhatsApp</button>
            <button class="btn btn--line btn--lg" type="submit" data-method="email">Enviar por email</button>
          </div>
          <p class="c-form-hint">{{ formNota or "WhatsApp abre la aplicación con sus datos listos para enviar. Por email nos llega directamente al buzón." }}</p>
        </form>

        <div class="form__success" id="formSuccess" role="status" hidden>
          <div class="form__success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div>
            <h4>{{ formExitoTitulo or "¡Solicitud enviada!" }}</h4>
            <p>{{ formExitoTexto or "Gracias. Le responderemos lo antes posible, normalmente el mismo día." }}</p>
            <p>Si lo prefiere, escríbanos por <a href="{{ '' | whatsapp(site.whatsapp) }}" target="_blank" rel="noopener">WhatsApp al {{ site.telefono_corto }}</a>.</p>
          </div>
        </div>
